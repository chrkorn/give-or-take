<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.GiveOrTake.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationContentDescription="@string/settings_back"
        app:title="@string/settings_title"
        app:titleTextColor="?attr/colorOnBackground" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_5"
            android:paddingTop="@dimen/space_5"
            android:paddingEnd="@dimen/space_5"
            android:paddingBottom="@dimen/space_5">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:text="@string/settings_session_length_label"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/settings_session_length_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:checkedButton="@id/settings_length_10"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_length_5"
                    style="@style/Widget.GiveOrTake.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
            android:minHeight="@dimen/size_button"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/settings_length_5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_length_10"
                    style="@style/Widget.GiveOrTake.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
            android:minHeight="@dimen/size_button"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/settings_length_10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_length_20"
                    style="@style/Widget.GiveOrTake.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
            android:minHeight="@dimen/size_button"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/settings_length_20" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/settings_session_length_explanation"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:text="@string/settings_answer_mode_label"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/settings_answer_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/settings_group_background"
                android:orientation="vertical">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/settings_mode_point"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_button_prominent"
                    android:paddingStart="@dimen/space_3"
                    android:paddingEnd="@dimen/space_3"
                    android:text="@string/settings_mode_point"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/settings_mode_interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_button_prominent"
                    android:paddingStart="@dimen/space_3"
                    android:paddingEnd="@dimen/space_3"
                    android:text="@string/settings_mode_interval"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/settings_mode_follow_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_button_prominent"
                    android:paddingStart="@dimen/space_3"
                    android:paddingEnd="@dimen/space_3"
                    android:text="@string/settings_mode_follow_level"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/settings_next_session_explanation"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:text="@string/settings_categories_label"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/settings_categories_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/settings_group_background"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_1"
                android:paddingBottom="@dimen/space_1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/settings_categories_explanation"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_thickness"
                android:layout_marginTop="@dimen/space_7"
                android:background="?attr/colorOutline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_reset_button"
                style="@style/Widget.GiveOrTake.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:minHeight="@dimen/size_button"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/settings_reset_action" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
