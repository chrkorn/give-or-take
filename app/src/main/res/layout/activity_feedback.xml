<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/feedback_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FeedbackActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/feedback_scroll"
        android:layout_width="@dimen/constraint_match"
        android:layout_height="@dimen/constraint_match"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/feedback_score"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/feedback_horizontal_margin"
            android:paddingTop="@dimen/feedback_top_margin"
            android:paddingEnd="@dimen/feedback_horizontal_margin"
            android:paddingBottom="@dimen/feedback_content_bottom_padding">

            <TextView
                android:id="@+id/feedback_answer_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/home_secondary_text"
                android:textSize="@dimen/feedback_overline_text_size"
                android:textStyle="bold"
                tools:text="@string/feedback_default_answer_number" />

            <TextView
                android:id="@+id/feedback_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/feedback_small_spacing"
                android:textColor="@color/home_on_background"
                android:textSize="@dimen/feedback_question_text_size"
                android:textStyle="bold"
                tools:text="@string/quiz_default_prompt" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/feedback_band_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/feedback_section_spacing"
                app:cardCornerRadius="@dimen/feedback_card_corner_radius"
                app:cardElevation="@dimen/elevation_none"
                app:strokeWidth="@dimen/feedback_band_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/feedback_card_padding">

                    <TextView
                        android:id="@+id/feedback_band_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/feedback_band_text_size"
                        android:textStyle="bold"
                        tools:text="@string/feedback_band_close" />

                    <TextView
                        android:id="@+id/feedback_band_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/feedback_small_spacing"
                        android:textSize="@dimen/feedback_body_text_size"
                        tools:text="@string/feedback_band_close_description" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/feedback_card_spacing"
                app:cardBackgroundColor="@color/home_card_background"
                app:cardCornerRadius="@dimen/feedback_card_corner_radius"
                app:cardElevation="@dimen/elevation_none"
                app:strokeColor="@color/home_card_outline"
                app:strokeWidth="@dimen/home_card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/feedback_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/feedback_guess_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/feedback_guess_label"
                            android:textColor="@color/home_secondary_text"
                            android:textSize="@dimen/feedback_body_text_size" />

                        <TextView
                            android:id="@+id/feedback_guess"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/feedback_small_spacing"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/home_card_content"
                            android:textSize="@dimen/feedback_value_text_size"
                            android:textStyle="bold"
                            tools:text="@string/feedback_default_guess" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/feedback_divider_height"
                        android:layout_marginTop="@dimen/feedback_row_spacing"
                        android:layout_marginBottom="@dimen/feedback_row_spacing"
                        android:background="@color/home_card_outline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/feedback_true_value_label"
                            android:textColor="@color/home_secondary_text"
                            android:textSize="@dimen/feedback_body_text_size" />

                        <TextView
                            android:id="@+id/feedback_true_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/feedback_small_spacing"
                            android:textColor="@color/home_card_content"
                            android:textSize="@dimen/feedback_value_text_size"
                            android:textStyle="bold"
                            tools:text="@string/feedback_default_truth" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/feedback_card_spacing"
                app:cardBackgroundColor="@color/home_card_background"
                app:cardCornerRadius="@dimen/feedback_card_corner_radius"
                app:cardElevation="@dimen/elevation_none"
                app:strokeColor="@color/home_card_outline"
                app:strokeWidth="@dimen/home_card_stroke_width">

                <TextView
                    android:id="@+id/feedback_comparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/feedback_card_padding"
                    android:textColor="@color/home_card_content"
                    android:textSize="@dimen/feedback_comparison_text_size"
                    android:textStyle="bold"
                    tools:text="@string/feedback_default_comparison" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/feedback_source_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/feedback_source_spacing"
                android:minHeight="@dimen/feedback_touch_target"
                android:textSize="@dimen/feedback_body_text_size"
                app:iconGravity="textEnd"
                tools:text="@string/feedback_default_source" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/feedback_score"
        android:layout_width="@dimen/constraint_match"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/feedback_horizontal_margin"
        android:layout_marginEnd="@dimen/feedback_horizontal_margin"
        android:layout_marginBottom="@dimen/feedback_score_spacing"
        android:textColor="@color/home_secondary_text"
        android:textSize="@dimen/feedback_body_text_size"
        app:layout_constraintBottom_toTopOf="@id/feedback_next_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="@string/feedback_default_score" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/feedback_next_button"
        style="@style/Widget.Material3.Button"
        android:layout_width="@dimen/constraint_match"
        android:layout_height="@dimen/feedback_next_button_height"
        android:layout_marginStart="@dimen/feedback_horizontal_margin"
        android:layout_marginEnd="@dimen/feedback_horizontal_margin"
        android:layout_marginBottom="@dimen/feedback_bottom_margin"
        android:text="@string/feedback_next"
        android:textSize="@dimen/home_button_text_size"
        app:cornerRadius="@dimen/home_button_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
