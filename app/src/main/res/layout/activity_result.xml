<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/result_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ResultActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/result_scroll"
        android:layout_width="@dimen/constraint_match"
        android:layout_height="@dimen/constraint_match"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/result_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/result_horizontal_margin"
            android:paddingTop="@dimen/result_top_margin"
            android:paddingEnd="@dimen/result_horizontal_margin"
            android:paddingBottom="@dimen/result_content_bottom_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/result_title"
                android:textColor="@color/home_on_background"
                android:textSize="@dimen/result_title_text_size"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_section_spacing"
                app:cardBackgroundColor="@color/home_card_background"
                app:cardCornerRadius="@dimen/result_card_corner_radius"
                app:cardElevation="@dimen/elevation_none"
                app:strokeColor="@color/home_card_outline"
                app:strokeWidth="@dimen/home_card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/result_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/result_session_score_label"
                        android:textAllCaps="true"
                        android:textColor="@color/home_secondary_text"
                        android:textSize="@dimen/result_label_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/result_score_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/result_small_spacing"
                        android:textColor="@color/home_card_content"
                        android:textSize="@dimen/result_score_text_size"
                        android:textStyle="bold"
                        tools:text="74 / 100" />

                    <TextView
                        android:id="@+id/result_score_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/result_text_spacing"
                        android:textColor="@color/home_secondary_text"
                        android:textSize="@dimen/result_body_text_size"
                        tools:text="On average, your estimates were within a factor of 1.5 of the truth." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/result_high_score_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_card_spacing"
                app:cardBackgroundColor="@color/home_card_background"
                app:cardCornerRadius="@dimen/result_card_corner_radius"
                app:cardElevation="@dimen/elevation_none"
                app:strokeColor="@color/home_card_outline"
                app:strokeWidth="@dimen/home_card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/result_card_padding">

                    <TextView
                        android:id="@+id/result_high_score_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/result_icon_spacing"
                        android:importantForAccessibility="no"
                        android:text="@string/result_high_score_icon"
                        android:textColor="@color/home_primary_button"
                        android:textSize="@dimen/result_high_score_icon_size" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/result_high_score_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:textColor="@color/home_card_content"
                            android:textSize="@dimen/result_label_text_size"
                            android:textStyle="bold"
                            tools:text="New personal best" />

                        <TextView
                            android:id="@+id/result_high_score_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/result_small_spacing"
                            android:textColor="@color/home_secondary_text"
                            android:textSize="@dimen/result_body_text_size"
                            tools:text="Previous 68 / 100" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/result_bands_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_card_spacing"
                app:cardBackgroundColor="@color/home_card_background"
                app:cardCornerRadius="@dimen/result_card_corner_radius"
                app:cardElevation="@dimen/elevation_none"
                app:strokeColor="@color/home_card_outline"
                app:strokeWidth="@dimen/home_card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/result_band_height"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/result_correct_shape"
                            android:textColor="@color/feedback_correct_content"
                            android:textSize="@dimen/result_shape_text_size" />

                        <TextView
                            android:id="@+id/result_correct_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/result_small_spacing"
                            android:textColor="@color/home_card_content"
                            android:textSize="@dimen/result_band_text_size"
                            android:textStyle="bold"
                            tools:text="4 correct" />

                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/feedback_divider_height"
                        android:layout_height="match_parent"
                        android:background="@color/home_card_outline" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/result_band_height"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/result_close_shape"
                            android:textColor="@color/feedback_close_content"
                            android:textSize="@dimen/result_shape_text_size" />

                        <TextView
                            android:id="@+id/result_close_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/result_small_spacing"
                            android:textColor="@color/home_card_content"
                            android:textSize="@dimen/result_band_text_size"
                            android:textStyle="bold"
                            tools:text="3 close" />

                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/feedback_divider_height"
                        android:layout_height="match_parent"
                        android:background="@color/home_card_outline" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/result_band_height"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/result_wrong_shape"
                            android:textColor="@color/feedback_wrong_content"
                            android:textSize="@dimen/result_shape_text_size" />

                        <TextView
                            android:id="@+id/result_wrong_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/result_small_spacing"
                            android:textColor="@color/home_card_content"
                            android:textSize="@dimen/result_band_text_size"
                            android:textStyle="bold"
                            tools:text="3 wrong" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/result_calibration_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_card_spacing"
                android:visibility="gone"
                app:cardBackgroundColor="@color/home_card_background"
                app:cardCornerRadius="@dimen/result_card_corner_radius"
                app:cardElevation="@dimen/elevation_none"
                app:strokeColor="@color/home_card_outline"
                app:strokeWidth="@dimen/home_card_stroke_width"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/result_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/result_calibration_label"
                        android:textAllCaps="true"
                        android:textColor="@color/home_secondary_text"
                        android:textSize="@dimen/result_label_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/result_calibration_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/result_text_spacing"
                        android:textColor="@color/home_card_content"
                        android:textSize="@dimen/result_calibration_text_size"
                        android:textStyle="bold"
                        tools:text="45 of 50 ranges contained the true value (90%)." />

                    <TextView
                        android:id="@+id/result_calibration_explanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/result_text_spacing"
                        android:textColor="@color/home_secondary_text"
                        android:textSize="@dimen/result_body_text_size"
                        tools:text="The target for 90% intervals is about 9 in 10." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/result_actions"
        android:layout_width="@dimen/constraint_match"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/result_horizontal_margin"
        android:paddingEnd="@dimen/result_horizontal_margin"
        android:paddingBottom="@dimen/result_bottom_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/result_play_again_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/result_button_height"
            android:text="@string/result_play_again"
            android:textSize="@dimen/home_button_text_size"
            app:cornerRadius="@dimen/home_button_corner_radius" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/result_button_spacing"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/result_home_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/result_button_height"
                android:layout_marginEnd="@dimen/result_button_gap_half"
                android:layout_weight="1"
                android:text="@string/result_home"
                android:textSize="@dimen/home_button_text_size"
                app:cornerRadius="@dimen/home_button_corner_radius" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/result_share_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/result_button_height"
                android:layout_marginStart="@dimen/result_button_gap_half"
                android:layout_weight="1"
                android:contentDescription="@string/result_share_placeholder_description"
                android:enabled="false"
                android:text="@string/result_share"
                android:textSize="@dimen/home_button_text_size"
                app:cornerRadius="@dimen/home_button_corner_radius" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
