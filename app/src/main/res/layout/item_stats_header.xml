<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/stats_horizontal_margin"
    android:paddingTop="@dimen/stats_top_margin"
    android:paddingEnd="@dimen/stats_horizontal_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/stats_headline_card_height"
            android:layout_marginEnd="@dimen/stats_card_gap_half"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/home_card_background"
            app:cardCornerRadius="@dimen/stats_card_corner_radius"
            app:cardElevation="@dimen/elevation_none"
            app:strokeColor="@color/home_card_outline"
            app:strokeWidth="@dimen/home_card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/stats_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_sessions_label"
                    android:textAllCaps="true"
                    android:textColor="@color/home_secondary_text"
                    android:textSize="@dimen/stats_label_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stats_sessions_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_text_spacing_small"
                    android:textColor="@color/home_card_content"
                    android:textSize="@dimen/stats_value_text_size"
                    android:textStyle="bold"
                    tools:text="37" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/stats_headline_card_height"
            android:layout_marginStart="@dimen/stats_card_gap_half"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/home_card_background"
            app:cardCornerRadius="@dimen/stats_card_corner_radius"
            app:cardElevation="@dimen/elevation_none"
            app:strokeColor="@color/home_card_outline"
            app:strokeWidth="@dimen/home_card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/stats_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_questions_label"
                    android:textAllCaps="true"
                    android:textColor="@color/home_secondary_text"
                    android:textSize="@dimen/stats_label_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stats_questions_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_text_spacing_small"
                    android:textColor="@color/home_card_content"
                    android:textSize="@dimen/stats_value_text_size"
                    android:textStyle="bold"
                    tools:text="412" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/stats_card_spacing"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/stats_headline_card_height"
            android:layout_marginEnd="@dimen/stats_card_gap_half"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/home_card_background"
            app:cardCornerRadius="@dimen/stats_card_corner_radius"
            app:cardElevation="@dimen/elevation_none"
            app:strokeColor="@color/home_card_outline"
            app:strokeWidth="@dimen/home_card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/stats_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_high_score_label"
                    android:textAllCaps="true"
                    android:textColor="@color/home_secondary_text"
                    android:textSize="@dimen/stats_label_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stats_high_score_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_text_spacing_small"
                    android:textColor="@color/home_card_content"
                    android:textSize="@dimen/stats_value_text_size"
                    android:textStyle="bold"
                    tools:text="84 / 100" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/stats_headline_card_height"
            android:layout_marginStart="@dimen/stats_card_gap_half"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/home_card_background"
            app:cardCornerRadius="@dimen/stats_card_corner_radius"
            app:cardElevation="@dimen/elevation_none"
            app:strokeColor="@color/home_card_outline"
            app:strokeWidth="@dimen/home_card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/stats_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_mean_closeness_label"
                    android:textAllCaps="true"
                    android:textColor="@color/home_secondary_text"
                    android:textSize="@dimen/stats_label_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stats_mean_closeness_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_text_spacing_small"
                    android:textColor="@color/home_card_content"
                    android:textSize="@dimen/stats_value_text_size"
                    android:textStyle="bold"
                    tools:text="×1.8" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/stats_section_spacing"
        app:cardBackgroundColor="@color/home_card_background"
        app:cardCornerRadius="@dimen/stats_card_corner_radius"
        app:cardElevation="@dimen/elevation_none"
        app:strokeColor="@color/home_card_outline"
        app:strokeWidth="@dimen/home_card_stroke_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/stats_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_confidently_wrong_title"
                android:textColor="@color/home_card_content"
                android:textSize="@dimen/stats_section_title_text_size"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/stats_no_ranges_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stats_card_spacing"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_no_ranges_title"
                    android:textColor="@color/home_card_content"
                    android:textSize="@dimen/stats_body_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_text_spacing_small"
                    android:text="@string/stats_no_ranges_message"
                    android:textColor="@color/home_secondary_text"
                    android:textSize="@dimen/stats_body_text_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stats_coverage_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stats_card_spacing"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/stats_coverage_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_card_content"
                    android:textSize="@dimen/stats_body_text_size"
                    tools:text="Your 90% ranges contained the true value 55% of the time." />

                <TextView
                    android:id="@+id/stats_calibration_verdict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_text_spacing_medium"
                    android:textColor="@color/home_secondary_text"
                    android:textSize="@dimen/stats_body_text_size"
                    tools:text="That is below the 90% aim. Your ranges have usually been too narrow." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_text_spacing_medium"
                    android:text="@string/stats_coverage_target"
                    android:textColor="@color/home_secondary_text"
                    android:textSize="@dimen/stats_secondary_text_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stats_insufficient_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stats_card_spacing"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/stats_insufficient_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_secondary_text"
                    android:textSize="@dimen/stats_body_text_size"
                    tools:text="You have given 12 ranges. Coverage stays hidden for now." />

                <TextView
                    android:id="@+id/stats_ranges_remaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_text_spacing_medium"
                    android:textColor="@color/home_card_content"
                    android:textSize="@dimen/stats_secondary_text_size"
                    android:textStyle="bold"
                    tools:text="38 more range answers until coverage is shown." />
            </LinearLayout>

            <View
                android:id="@+id/stats_width_divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/feedback_divider_height"
                android:layout_marginTop="@dimen/stats_card_spacing"
                android:background="@color/home_card_outline" />

            <LinearLayout
                android:id="@+id/stats_width_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stats_card_spacing"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_mean_interval_width"
                        android:textColor="@color/home_card_content"
                        android:textSize="@dimen/stats_body_text_size" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_text_spacing_small"
                        android:text="@string/stats_mean_interval_width_explanation"
                        android:textColor="@color/home_secondary_text"
                        android:textSize="@dimen/stats_secondary_text_size" />
                </LinearLayout>

                <TextView
                    android:id="@+id/stats_mean_width_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/stats_card_spacing"
                    android:textColor="@color/home_card_content"
                    android:textSize="@dimen/stats_session_score_text_size"
                    android:textStyle="bold"
                    tools:text="×12" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/stats_chart_height"
        android:layout_marginTop="@dimen/stats_card_spacing"
        app:cardBackgroundColor="@color/home_card_background"
        app:cardCornerRadius="@dimen/stats_card_corner_radius"
        app:cardElevation="@dimen/elevation_none"
        app:strokeColor="@color/home_card_outline"
        app:strokeWidth="@dimen/home_card_stroke_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/stats_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_chart_title"
                android:textAllCaps="true"
                android:textColor="@color/home_secondary_text"
                android:textSize="@dimen/stats_label_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_text_spacing_medium"
                android:text="@string/stats_chart_placeholder"
                android:textColor="@color/home_secondary_text"
                android:textSize="@dimen/stats_body_text_size" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/stats_section_spacing"
        android:layout_marginBottom="@dimen/stats_card_spacing"
        android:text="@string/stats_past_sessions"
        android:textAllCaps="true"
        android:textColor="@color/home_secondary_text"
        android:textSize="@dimen/stats_label_text_size"
        android:textStyle="bold" />

</LinearLayout>
