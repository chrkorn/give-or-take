<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StatsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/stats_toolbar"
        style="@style/Widget.GiveOrTake.Toolbar"
        android:layout_width="@dimen/constraint_match"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:contentInsetStart="0dp"
        android:contentInsetStartWithNavigation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/stats_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/stats_title"
        app:titleTextColor="?attr/colorOnBackground"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <FrameLayout
        android:id="@+id/stats_state_container"
        android:layout_width="@dimen/constraint_match"
        android:layout_height="@dimen/constraint_match"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stats_toolbar">

        <LinearLayout
            android:id="@+id/stats_loading_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_6">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="@dimen/space_7"
                android:layout_height="@dimen/space_7"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/stats_loading"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/stats_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_5"
                android:paddingTop="@dimen/space_5"
                android:paddingEnd="@dimen/space_5"
                android:paddingBottom="@dimen/space_5">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_empty_title"
                    android:textColor="?attr/colorOnBackground"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stats_empty_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    tools:text="Play one session and this screen will fill in." />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="@dimen/shape_corner_medium"
                    app:cardElevation="@dimen/elevation_none"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="@dimen/stroke_thin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_4">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_empty_preview_title"
                            android:textAllCaps="true"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/stats_empty_preview_coverage"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/stats_empty_preview_closeness"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/stats_empty_preview_sessions"
                            android:textColor="?attr/colorOnSurface"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stats_start_session_button"
                    style="@style/Widget.GiveOrTake.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/size_button"
                    android:layout_marginTop="@dimen/space_5"
                    android:text="@string/stats_start_session" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/stats_error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_6"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/stats_load_error_title"
                android:textColor="?attr/colorOnBackground"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center"
                android:text="@string/stats_load_error_message"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stats_retry_button"
                style="@style/Widget.GiveOrTake.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/stats_retry" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stats_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_5"
            android:scrollbars="vertical"
            android:visibility="gone"
            tools:listitem="@layout/item_stats_session" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
