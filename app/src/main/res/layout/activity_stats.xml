<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StatsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/stats_toolbar"
        android:layout_width="@dimen/constraint_match"
        android:layout_height="@dimen/stats_toolbar_height"
        android:background="@color/home_background"
        android:contentInsetStart="0dp"
        android:contentInsetStartWithNavigation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/stats_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/stats_title"
        app:titleTextColor="@color/home_on_background"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <FrameLayout
        android:id="@+id/stats_state_container"
        android:layout_width="@dimen/constraint_match"
        android:layout_height="@dimen/constraint_match"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stats_toolbar">

        <LinearLayout
            android:id="@+id/stats_loading_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/stats_state_padding">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="@dimen/stats_progress_size"
                android:layout_height="@dimen/stats_progress_size"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stats_empty_spacing"
                android:text="@string/stats_loading"
                android:textColor="@color/home_secondary_text"
                android:textSize="@dimen/stats_body_text_size" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/stats_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/stats_horizontal_margin"
                android:paddingTop="@dimen/stats_top_margin"
                android:paddingEnd="@dimen/stats_horizontal_margin"
                android:paddingBottom="@dimen/stats_bottom_margin">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_empty_title"
                    android:textColor="@color/home_on_background"
                    android:textSize="@dimen/stats_value_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stats_empty_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/stats_card_spacing"
                    android:textColor="@color/home_secondary_text"
                    android:textSize="@dimen/stats_body_text_size"
                    tools:text="Play one session and this screen will fill in." />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/stats_section_spacing"
                    app:cardBackgroundColor="@color/home_card_background"
                    app:cardCornerRadius="@dimen/stats_card_corner_radius"
                    app:cardElevation="@dimen/elevation_none"
                    app:strokeColor="@color/home_card_outline"
                    app:strokeWidth="@dimen/home_card_stroke_width">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/stats_card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_empty_preview_title"
                            android:textAllCaps="true"
                            android:textColor="@color/home_secondary_text"
                            android:textSize="@dimen/stats_label_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/stats_empty_row_spacing"
                            android:text="@string/stats_empty_preview_coverage"
                            android:textColor="@color/home_card_content"
                            android:textSize="@dimen/stats_body_text_size" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/stats_empty_row_spacing"
                            android:text="@string/stats_empty_preview_closeness"
                            android:textColor="@color/home_card_content"
                            android:textSize="@dimen/stats_body_text_size" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/stats_empty_row_spacing"
                            android:text="@string/stats_empty_preview_sessions"
                            android:textColor="@color/home_card_content"
                            android:textSize="@dimen/stats_body_text_size" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stats_start_session_button"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/result_button_height"
                    android:layout_marginTop="@dimen/stats_section_spacing"
                    android:text="@string/stats_start_session"
                    app:backgroundTint="@color/home_primary_button"
                    app:cornerRadius="@dimen/home_button_corner_radius" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/stats_error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/stats_state_padding"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/stats_load_error_title"
                android:textColor="@color/home_on_background"
                android:textSize="@dimen/stats_section_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stats_card_spacing"
                android:gravity="center"
                android:text="@string/stats_load_error_message"
                android:textColor="@color/home_secondary_text"
                android:textSize="@dimen/stats_body_text_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stats_retry_button"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stats_empty_spacing"
                android:text="@string/stats_retry" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stats_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/stats_bottom_margin"
            android:scrollbars="vertical"
            android:visibility="gone"
            tools:listitem="@layout/item_stats_session" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
