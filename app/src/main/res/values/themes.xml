<resources>
    <style name="Base.Theme.GiveOrTake" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/theme_primary</item>
        <item name="colorOnPrimary">@color/theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_on_primary_container</item>
        <item name="colorSecondary">@color/theme_secondary</item>
        <item name="colorOnSecondary">@color/theme_on_secondary</item>
        <item name="colorSecondaryContainer">@color/theme_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_on_secondary_container</item>
        <item name="colorTertiary">@color/theme_tertiary</item>
        <item name="colorOnTertiary">@color/theme_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/theme_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/theme_on_tertiary_container</item>
        <item name="colorError">@color/theme_error</item>
        <item name="colorOnError">@color/theme_on_error</item>
        <item name="colorErrorContainer">@color/theme_error_container</item>
        <item name="colorOnErrorContainer">@color/theme_on_error_container</item>
        <item name="android:colorBackground">@color/theme_background</item>
        <item name="colorOnBackground">@color/theme_on_background</item>
        <item name="colorSurface">@color/theme_surface</item>
        <item name="colorOnSurface">@color/theme_on_surface</item>
        <item name="colorSurfaceVariant">@color/theme_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/theme_on_surface_variant</item>
        <item name="colorOutline">@color/theme_outline</item>
        <item name="colorOutlineVariant">@color/theme_outline_variant</item>
        <item name="colorSurfaceInverse">@color/theme_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/theme_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/theme_inverse_primary</item>
        <item name="colorSurfaceBright">@color/theme_surface_bright</item>
        <item name="colorSurfaceDim">@color/theme_surface_dim</item>
        <item name="colorSurfaceContainerLowest">@color/theme_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/theme_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/theme_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/theme_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/theme_surface_container_highest</item>

        <item name="android:navigationBarColor">@color/theme_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>

        <item name="materialButtonStyle">@style/Widget.GiveOrTake.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.GiveOrTake.Card.Outlined</item>
    </style>

    <style name="Theme.GiveOrTake" parent="Base.Theme.GiveOrTake" />

    <style name="Widget.GiveOrTake.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/size_button</item>
        <item name="cornerRadius">@dimen/shape_corner_medium</item>
    </style>

    <style name="Widget.GiveOrTake.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/size_button</item>
        <item name="cornerRadius">@dimen/shape_corner_medium</item>
    </style>

    <style name="Widget.GiveOrTake.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/size_touch_target</item>
    </style>

    <style name="Widget.GiveOrTake.Button.Danger" parent="Widget.GiveOrTake.Button.Secondary">
        <item name="android:textColor">@color/settings_destructive</item>
        <item name="strokeColor">@color/settings_destructive</item>
    </style>

    <style name="Widget.GiveOrTake.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/home_card_background</item>
        <item name="cardCornerRadius">@dimen/shape_corner_medium</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeColor">@color/home_card_outline</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
    </style>

    <style name="Widget.GiveOrTake.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/theme_background</item>
        <item name="navigationIconTint">@color/theme_on_background</item>
        <item name="titleTextColor">@color/theme_on_background</item>
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
    </style>
</resources>
